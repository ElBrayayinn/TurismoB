# URL base del backend (proxy del calendario de Google).
# Copia este archivo a .env y ajusta si el backend corre en otro host/puerto.
VITE_API_URL=http://localhost:3001

# API Key de Google Maps Platform (Maps JavaScript API, Directions API, Geocoding API).
# Debe estar restringida por HTTP referrer en Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=
