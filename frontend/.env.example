# URL base del backend (proxy del calendario de Google).
# Copia este archivo a .env y ajusta si el backend corre en otro host/puerto.
VITE_API_URL=http://localhost:3001

# ─── Google Maps Platform ───────────────────────────────────
# OBLIGATORIA: sin esta clave los mapas y las rutas no cargan (el navegador
# muestra un recuadro gris y el error "InvalidKeyMapError" en la consola).
#
# APIs que hay que habilitar en Google Cloud Console para este proyecto:
#   - Maps JavaScript API  → mapas de la ficha del sitio y del panel
#   - Directions API       → trazado y ETA de las rutas
# (La geocodificación de direcciones NO usa Google: la resuelve el backend
#  contra Nominatim/OpenStreetMap en /api/geocode.)
#
# La clave viaja en el paquete JavaScript del navegador, así que DEBE estar
# restringida por referente HTTP en Google Cloud Console
# (p. ej. https://turismo.itagui.gov.co/*  y  http://localhost:5173/*).
VITE_GOOGLE_MAPS_API_KEY=

# ID del estilo de mapa (Map ID). Es necesario para los marcadores avanzados
# (AdvancedMarker). Si se deja vacío se usa 'DEMO_MAP_ID', el mapa de prueba de
# Google, que Google documenta como SOLO PARA DESARROLLO: para producción hay
# que crear un Map ID propio en "Google Maps Platform > Map management".
VITE_GOOGLE_MAPS_MAP_ID=
