# Dependencias
node_modules/
frontend/node_modules/
backend/node_modules/

# Imágenes subidas por el usuario (se conservan en el servidor, no en git)
backend/uploads/*
!backend/uploads/.gitkeep

# Build de producción (se genera con "npm run build")
frontend/dist/
dist/

# Base de datos SQLite local de desarrollo
backend/*.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Variables de entorno
.env
.env.local
.env.*.local

# Archivos temporales / scratch
scratch_*.json
scratch_*.html

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
